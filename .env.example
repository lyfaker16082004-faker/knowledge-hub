# Reference only: Spring Boot does not automatically load this file.
# Set these variables in the terminal that starts the backend.
DB_URL=jdbc:mysql://localhost:3306/knowledge_hub?serverTimezone=Asia/Bangkok&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=root
DB_PASSWORD=your-local-mysql-password
# Optional private upload storage (Spring Boot environment property)
APP_DOCUMENTS_STORAGE_DIR=./config/document-storage

# Required in prod: random Base64 signing key containing at least 32 bytes
APP_JWT_SECRET=
APP_AVATARS_STORAGE_DIR=./config/avatar-storage
